{
    "swagger": "2.0",
    "info": {
        "description": "API documentation for Magooify, a self-contained Go application framework.",
        "title": "Magooify API",
        "contact": {},
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/health": {
            "get": {
                "description": "Returns operational status of the service.",
                "produces": [
                    "application/json"
                ],
                "summary": "Health Check",
                "responses": {
                    "200": {
                        "description": "Healthy response",
                        "schema": {
                            "$ref": "#/definitions/HealthResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/images": {
            "get": {
                "description": "Lists the processed images stored in the configured output directory, newest first.",
                "produces": [
                    "application/json"
                ],
                "summary": "List Stored Images",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ImagesResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/images/{filename}": {
            "get": {
                "description": "Serves a processed image stored in the output directory.",
                "produces": [
                    "application/octet-stream"
                ],
                "summary": "Get Stored Image",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Image filename",
                        "name": "filename",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/info": {
            "get": {
                "description": "Returns system metrics, Go version, OS/Arch, and uptime.",
                "produces": [
                    "application/json"
                ],
                "summary": "System Info",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/SystemInfoResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/items": {
            "get": {
                "description": "Returns all stored items.",
                "produces": [
                    "application/json"
                ],
                "summary": "List Items",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ItemsResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Creates a new item.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Create Item",
                "parameters": [
                    {
                        "description": "Item to create",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/CreateItemRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/Item"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/process": {
            "post": {
                "description": "Accepts an image captured by the camera or uploaded by the user, sends it to an OpenRouter vision model for processing, then stores the image and the resulting description in the configured output directory.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Process an Image with OpenRouter",
                "parameters": [
                    {
                        "type": "file",
                        "description": "Image to process",
                        "name": "image",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ProcessImageResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/user": {
            "get": {
                "description": "Returns authenticated user info based on environment or proxy headers.",
                "produces": [
                    "application/json"
                ],
                "summary": "Get Current User",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/UserInfo"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "CreateItemRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "example": "Sample Item"
                }
            }
        },
        "ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Invalid request payload"
                }
            }
        },
        "HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                },
                "timestamp": {
                    "type": "string",
                    "example": "2026-08-04T12:00:00Z"
                }
            }
        },
        "ImagesResponse": {
            "type": "object",
            "properties": {
                "images": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/StoredImage"
                    }
                }
            }
        },
        "Item": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "created_by": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "ItemsResponse": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Item"
                    }
                }
            }
        },
        "ProcessImageResponse": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "example": "A sunny garden with a wooden bench."
                },
                "filename": {
                    "type": "string",
                    "example": "img-20260806-123000-a1b2c3d4.jpg"
                },
                "model": {
                    "type": "string",
                    "example": "google/gemini-3.1-flash-lite-image"
                },
                "processed_at": {
                    "type": "string"
                },
                "text_file": {
                    "type": "string",
                    "example": "img-20260806-123000-a1b2c3d4.txt"
                }
            }
        },
        "StoredImage": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "example": "A sunny garden with a wooden bench."
                },
                "filename": {
                    "type": "string",
                    "example": "img-20260806-123000-a1b2c3d4.jpg"
                },
                "modified": {
                    "type": "string"
                },
                "size": {
                    "type": "integer",
                    "example": 48291
                },
                "text_file": {
                    "type": "string",
                    "example": "img-20260806-123000-a1b2c3d4.txt"
                }
            }
        },
        "SystemInfoResponse": {
            "type": "object",
            "properties": {
                "arch": {
                    "type": "string",
                    "example": "amd64"
                },
                "go_version": {
                    "type": "string",
                    "example": "go1.24.4"
                },
                "mode": {
                    "type": "string",
                    "example": "desktop"
                },
                "os": {
                    "type": "string",
                    "example": "linux"
                },
                "uptime": {
                    "type": "string",
                    "example": "12m30s"
                }
            }
        },
        "UserInfo": {
            "type": "object",
            "properties": {
                "auth_type": {
                    "type": "string",
                    "example": "local_env"
                },
                "mode": {
                    "type": "string",
                    "example": "desktop"
                },
                "username": {
                    "type": "string",
                    "example": "alice"
                }
            }
        }
    }
}